{
  "name": "battle-royal",
  "version": "1.1.0",
  "description": "battle royal api",
  "main": "server.js",
  "scripts": {
    "clean": "rm -rf build && mkdir build",
    "build-babel": "babel -d ./build . -s --ignore 'node_modules/**'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run clean && npm run build-babel",
    "start": "npm run build && node --trace-warnings ./build/server.js",
    "lint": "eslint . --fix",
    "dev": "nodemon --exec babel-node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satishjhanwer/battle-royal.git"
  },
  "keywords": [
    "Express",
    "MongoDB",
    "MLab",
    "Mongoose",
    "Node",
    "JWT",
    "Heroku"
  ],
  "author": "Satish Jhanwer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/satishjhanwer/battle-royal/issues"
  },
  "homepage": "https://github.com/satishjhanwer/battle-royal#readme",
  "dependencies": {
    "async": "3.2.6",
    "bcryptjs": "3.0.3",
    "body-parser": "2.3.0",
    "csvtojson": "2.0.14",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongoose": "9.11.2"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "^10.0.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "yarn@4.18.1"
}
